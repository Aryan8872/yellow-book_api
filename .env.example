# Server Environment Configuration
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Database (Railway PostgreSQL — copy the DATABASE_URL from your Railway PostgreSQL service)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis Connection (Defaults to local or Railway REDIS_URL)
REDIS_URL=redis://127.0.0.1:6379

# JWT Secrets (Minimum 32 characters for production HMAC-SHA256)
JWT_SECRET=super_secret_enterprise_jwt_token_key_change_me_in_prod_32chars!
JWT_REFRESH_SECRET=super_secret_refresh_token_key_for_long_sessions_32chars!

# OAuth Credentials (Google)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=https://your-backend-url.railway.app/api/v1/auth/google/callback

# Allowed CORS Origins (Comma-separated - include your frontend Vercel URL)
CORS_ALLOWED_ORIGINS=https://your-frontend-url.vercel.app,http://localhost:3000,http://localhost:8080,http://localhost:5173,http://localhost:3001

# File Storage Configuration ('local' or 'cloudinary')
# IMPORTANT: Use 'cloudinary' for Railway deployment - local storage is ephemeral
STORAGE_DRIVER=cloudinary
APP_BASE_URL=https://your-backend-url.railway.app

# Cloudinary Credentials (REQUIRED when STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

