// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  MERCHANT_STAFF
  MERCHANT_ADMIN
  ADMIN
}

enum SubscriptionStatus {
  INACTIVE
  PENDING_PAYMENT
  ACTIVE
  IN_GRACE_PERIOD
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum PlanAudience {
  MERCHANT
  USER
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  BIANNUAL
  ANNUAL
  LIFETIME
}

enum PaymentGateway {
  ESEWA
  KHALTI
  MANUAL_ADMIN
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum MerchantStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OfferCategory {
  DINING
  WELLNESS
  ENTERTAINMENT
  RETAIL
  TRAVEL
  BEAUTY
}

// Operating districts the platform currently supports
enum District {
  JHAPA
  KATHMANDU
  CHITWAN
  POKHARA
}

// ─────────────────────────────────────────────────────────────────────────────
// CATEGORY MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  iconUrl     String?  @map("icon_url")
  imageUrl    String?  @map("image_url")
  color       String?  @default("#6366f1") // Hex color for UI
  isActive    Boolean  @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order") // For sorting in UI
  offerCount  Int      @default(0) @map("offer_count") // Cached count of active offers
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  offers Offer[]

  @@index([isActive])
  @@index([displayOrder])
  @@map("categories")
}

enum RedemptionStatus {
  INIT
  PENDING_SYNC
  REDEEMED
  REJECTED
  EXPIRED
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
  APPLE
}

// ─────────────────────────────────────────────────────────────────────────────
// USER MODULE
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  phone                 String?   @unique
  passwordHash          String?   @map("password_hash")
  name                  String?
  avatarUrl             String?   @map("avatar_url")
  role                  UserRole  @default(USER)
  isVerified            Boolean   @default(false) @map("is_verified")
  isActive              Boolean   @default(true) @map("is_active")
  timezone              String    @default("Asia/Kathmandu")
  refreshToken          String?   @map("refresh_token")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  emailVerified         Boolean   @default(false) @map("email_verified")
  passwordResetToken    String?   @map("password_reset_token")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")
  emailVerificationToken String?   @map("email_verification_token")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at") // Soft delete

  // Relations
  subscription     Subscription?
  subscriptionRecords SubscriptionRecord[]
  paymentTransactions PaymentTransaction[]
  invoices         Invoice[]
  oauthAccounts    OAuthAccount[]
  redemptions      RedemptionSession[]
  familyGroup      FamilyGroup?        @relation("FamilyOwner")
  familyMembership FamilyGroup?        @relation("FamilyMember", fields: [familyGroupId], references: [id])
  familyGroupId    String?             @map("family_group_id")
  merchantStaff    MerchantStaff?
  auditLogs        AuditLog[]          @relation("AuditActor")
  favourites       UserFavourite[]
  reviews          Review[]
  helpfulVotes     ReviewHelpfulVote[]
  reports          ReviewReport[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([refreshToken])
  @@map("users")
}

model OAuthAccount {
  id           String        @id @default(cuid())
  userId       String        @map("user_id")
  provider     OAuthProvider
  providerId   String        @map("provider_id")
  accessToken  String?       @map("access_token")
  refreshToken String?       @map("refresh_token")
  expiresAt    DateTime?     @map("expires_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model FamilyGroup {
  id         String   @id @default(cuid())
  ownerId    String   @unique @map("owner_id")
  maxMembers Int      @default(4) @map("max_members")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  owner   User   @relation("FamilyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members User[] @relation("FamilyMember")

  @@map("family_groups")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUBSCRIPTION MODULE
// ─────────────────────────────────────────────────────────────────────────────

model SubscriptionPlan {
  id               String           @id @default(cuid())
  code             String           @unique
  name             String
  description      String?
  audience         PlanAudience     // MERCHANT | USER
  priceNpr         Decimal          @map("price_npr") @db.Decimal(10, 2)
  billingCycle     BillingCycle     @default(MONTHLY) @map("billing_cycle")
  durationDays     Int              @default(30) @map("duration_days")
  trialDays        Int              @default(0) @map("trial_days")
  isActive         Boolean          @default(true) @map("is_active")
  isArchived       Boolean          @default(false) @map("is_archived")
  isPublic         Boolean          @default(true) @map("is_public")
  entitlementsJson Json             @map("entitlements_json")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  subscriptions    SubscriptionRecord[]

  @@index([audience, isActive])
  @@map("subscription_plans")
}

model SubscriptionRecord {
  id                 String             @id @default(cuid())
  planId             String             @map("plan_id")
  merchantId         String?            @map("merchant_id")
  userId             String?            @map("user_id")
  status             SubscriptionStatus @default(ACTIVE)
  isTrial            Boolean            @default(false) @map("is_trial")
  startedAt          DateTime           @default(now()) @map("started_at")
  currentPeriodStart DateTime           @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  gracePeriodEndsAt  DateTime?          @map("grace_period_ends_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  autoRenew          Boolean            @default(true) @map("auto_renew")
  isManualOverride   Boolean            @default(false) @map("is_manual_override")
  overrideReason     String?            @map("override_reason")
  overrideAdminId    String?            @map("override_admin_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  merchant           Merchant?          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user               User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices           Invoice[]
  payments           PaymentTransaction[]

  @@index([merchantId, status])
  @@index([userId, status])
  @@index([currentPeriodEnd, status])
  @@map("subscription_records")
}

model SystemTrialConfig {
  id                String       @id @default(cuid())
  audience          PlanAudience @unique
  isEnabled         Boolean      @default(true) @map("is_enabled")
  defaultPeriodDays Int          @default(180) @map("default_period_days")
  unlimitedRedeems  Boolean      @default(true) @map("unlimited_redeems")
  notes             String?
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@map("system_trial_configs")
}

model PaymentTransaction {
  id              String             @id @default(cuid())
  subscriptionId  String?            @map("subscription_id")
  merchantId      String?            @map("merchant_id")
  userId          String?            @map("user_id")
  gateway         PaymentGateway
  gatewayRefId    String?            @map("gateway_ref_id")
  orderId         String             @unique @map("order_id")
  amountNpr       Decimal            @map("amount_npr") @db.Decimal(10, 2)
  status          PaymentStatus      @default(INITIATED)
  idempotencyKey  String             @unique @map("idempotency_key")
  gatewayResponse Json?              @map("gateway_response")
  failureReason   String?            @map("failure_reason")
  paidAt          DateTime?          @map("paid_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  subscription    SubscriptionRecord? @relation(fields: [subscriptionId], references: [id])
  user            User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice         Invoice?

  @@index([orderId])
  @@index([gatewayRefId])
  @@index([status])
  @@map("payment_transactions")
}

model Invoice {
  id             String             @id @default(cuid())
  invoiceNumber  String             @unique @map("invoice_number")
  subscriptionId String             @map("subscription_id")
  paymentId      String?            @unique @map("payment_id")
  merchantId     String?            @map("merchant_id")
  userId         String?            @map("user_id")
  amountNpr      Decimal            @map("amount_npr") @db.Decimal(10, 2)
  taxAmountNpr   Decimal            @default(0) @map("tax_amount_npr") @db.Decimal(10, 2)
  status         String             @default("PAID")
  pdfUrl         String?            @map("pdf_url")
  sentEmailTo    String?            @map("sent_email_to")
  sentAt         DateTime?          @map("sent_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  subscription   SubscriptionRecord @relation(fields: [subscriptionId], references: [id])
  user           User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment        PaymentTransaction? @relation(fields: [paymentId], references: [id])

  @@map("invoices")
}

// Backward compatibility legacy models
model Plan {
  id           String  @id @default(cuid())
  name         String  @unique
  description  String?
  priceNpr     Decimal @map("price_npr") @db.Decimal(10, 2)
  billingCycle String  @map("billing_cycle")
  isActive     Boolean @default(true) @map("is_active")
  benefitsJson Json    @map("benefits_json")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String             @unique @map("user_id")
  planId            String             @map("plan_id")
  status            SubscriptionStatus @default(INACTIVE)
  pspCustomerId     String?            @map("psp_customer_id")
  pspSubscriptionId String?            @map("psp_subscription_id")
  startedAt         DateTime?          @map("started_at")
  endsAt            DateTime?          @map("ends_at")
  cancelledAt       DateTime?          @map("cancelled_at")
  gracePeriodEndsAt DateTime?          @map("grace_period_ends_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([endsAt])
  @@map("subscriptions")
}

model PspWebhookEvent {
  id          String   @id
  psp         String
  eventType   String   @map("event_type")
  payload     Json
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("psp_webhook_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// MERCHANT MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Merchant {
  id                 String         @id @default(cuid())
  name               String
  description        String?
  logoUrl            String?        @map("logo_url")
  coverUrl           String?        @map("cover_url")
  websiteUrl         String?        @map("website_url")
  status             MerchantStatus @default(PENDING_REVIEW)
  merchantPinHash    String?        @map("merchant_pin_hash") // 4-digit PIN bcrypt hash
  registrationNumber String?        @map("registration_number")
  vatNumber          String?        @map("vat_number")
  contactEmail       String?        @map("contact_email")
  contactPhone       String?        @map("contact_phone")
  address            String?        @map("address")
  onboardedAt        DateTime?      @map("onboarded_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  // Relations
  branches  MerchantBranch[]
  offers    Offer[]
  staff     MerchantStaff[]
  payouts   Payout[]
  auditLogs AuditLog[]       @relation("MerchantAudit")
  subscriptions SubscriptionRecord[]
  reviews   Review[]

  @@index([status])
  @@map("merchants")
}

model MerchantBranch {
  id             String    @id @default(cuid())
  merchantId     String    @map("merchant_id")
  name           String
  address        String
  phone          String
  district       District
  lat            Decimal   @db.Decimal(10, 8)
  lng            Decimal   @db.Decimal(11, 8)
  isActive       Boolean   @default(true) @map("is_active")
  operatingHours Json?     @map("operating_hours") // { monday: { open, close, closed? }, ... }
  createdAt      DateTime  @default(now()) @map("created_at")

  // Relations
  merchant    Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  redemptions RedemptionSession[]
  offers      Offer[]             @relation("OfferBranches")

  @@index([merchantId])
  // PostGIS or application-level geospatial queries on lat/lng
  @@index([lat, lng])
  @@map("merchant_branches")
}

model MerchantStaff {
  id         String   @id @default(cuid())
  merchantId String   @map("merchant_id")
  userId     String   @unique @map("user_id")
  role        UserRole @default(MERCHANT_STAFF)
  permissions String[] @default([]) // Granular staff capabilities: 'redeem' | 'manage_offers' | 'view_reports'
  deviceId    String?  @map("device_id") // Registered terminal/device fingerprint
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  merchant    Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  redemptions RedemptionSession[] @relation("StaffRedemptions")

  @@index([merchantId])
  @@map("merchant_staff")
}

// ─────────────────────────────────────────────────────────────────────────────
// OFFERS MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Offer {
  id                  String   @id @default(cuid())
  merchantId          String   @map("merchant_id")
  categoryId          String   @map("category_id")
  title               String
  description         String
  terms               String
  estimatedSavingsNpr Decimal  @map("estimated_savings_npr") @db.Decimal(10, 2)
  originalPriceNpr    Decimal? @map("original_price_npr") @db.Decimal(10, 2)
  discountPercentage  Int?     @map("discount_percentage")
  coverImage          String?  @map("cover_image")
  images              String[] @default([])
  highlights          String[] @default([])
  rating              Decimal  @default(4.8) @db.Decimal(3, 2)
  reviewsCount        Int      @default(0) @map("reviews_count")
  isActive            Boolean  @default(true) @map("is_active")
  isFeatured          Boolean  @default(false) @map("is_featured")
  availabilityJson    Json?    @map("availability_json") // days/hours restrictions
  validFrom           DateTime? @map("valid_from")
  validUntil          DateTime? @map("valid_until")
  viewCount           Int      @default(0) @map("view_count") // Track offer views for trending
  redemptionCount     Int      @default(0) @map("redemption_count") // Track redemptions for popularity
  trendingScore       Decimal  @default(0) @map("trending_score") @db.Decimal(10, 2) // Calculated trending score
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  merchant    Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  branches    MerchantBranch[]    @relation("OfferBranches")
  redemptions RedemptionSession[]
  favourites  UserFavourite[]
  reviews     Review[]

  @@index([merchantId])
  @@index([categoryId])
  @@index([isActive])
  @@index([trendingScore])
  @@index([redemptionCount])
  @@map("offers")
}

// ─────────────────────────────────────────────────────────────────────────────
// FAVOURITES MODULE
// ─────────────────────────────────────────────────────────────────────────────

model UserFavourite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  offerId   String   @map("offer_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
  @@index([userId])
  @@index([offerId])
  @@map("user_favourites")
}

// ─────────────────────────────────────────────────────────────────────────────
// REDEMPTION MODULE
// ─────────────────────────────────────────────────────────────────────────────

model RedemptionSession {
  id            String           @id @default(cuid())
  userId        String           @map("user_id")
  offerId       String           @map("offer_id")
  branchId      String?          @map("branch_id")
  staffId       String?          @map("staff_id")
  code          String           @unique
  status        RedemptionStatus @default(INIT)
  savingsNpr    Decimal          @map("savings_npr") @db.Decimal(10, 2)
  codeExpiresAt DateTime         @map("code_expires_at")
  redeemedAt    DateTime?        @map("redeemed_at")
  deviceInfo    String?          @map("device_info")
  userLat       Decimal?         @map("user_lat") @db.Decimal(10, 8)
  userLng       Decimal?         @map("user_lng") @db.Decimal(11, 8)
  geoFlagReason String?          @map("geo_flag_reason")
  createdAt     DateTime         @default(now()) @map("created_at")

  // Relations
  user   User            @relation(fields: [userId], references: [id])
  offer  Offer           @relation(fields: [offerId], references: [id])
  branch MerchantBranch? @relation(fields: [branchId], references: [id])
  staff  MerchantStaff?  @relation("StaffRedemptions", fields: [staffId], references: [id])

  @@index([userId])
  @@index([offerId])
  @@index([code])
  @@index([status])
  @@index([createdAt])
  // Fraud: Only one REDEEMED status per user+offer combination per day is enforced at app level
  @@map("redemption_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// FINANCIAL LEDGER
// ─────────────────────────────────────────────────────────────────────────────

model Payout {
  id               String    @id @default(cuid())
  merchantId       String    @map("merchant_id")
  periodStart      DateTime  @map("period_start")
  periodEnd        DateTime  @map("period_end")
  totalRedemptions Int       @map("total_redemptions")
  payoutAmountNpr  Decimal   @map("payout_amount_npr") @db.Decimal(10, 2)
  status           String    @default("PENDING") // PENDING | PROCESSING | PAID | DISPUTED
  paidAt           DateTime? @map("paid_at")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relations
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([status])
  @@map("payouts")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT & FRAUD
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  entity     String // 'User' | 'Merchant' | 'Offer' | 'RedemptionSession'
  entityId   String   @map("entity_id")
  action     String // 'create' | 'update' | 'delete' | 'redeem'
  actorId    String?  @map("actor_id")
  merchantId String?  @map("merchant_id")
  metadata   Json? // Context (changed fields, IP, device)
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  actor    User?     @relation("AuditActor", fields: [actorId], references: [id])
  merchant Merchant? @relation("MerchantAudit", fields: [merchantId], references: [id])

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model FraudFlag {
  id           String    @id @default(cuid())
  redemptionId String    @map("redemption_id")
  reason       String // 'GEO_MISMATCH' | 'RAPID_REDEEM' | 'PIN_BRUTE_FORCE'
  severity     String // 'LOW' | 'MEDIUM' | 'HIGH' | 'CRITICAL'
  reviewedBy   String?   @map("reviewed_by")
  resolvedAt   DateTime? @map("resolved_at")
  resolution   String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([redemptionId])
  @@index([severity])
  @@index([resolvedAt])
  @@map("fraud_flags")
}

// ─────────────────────────────────────────────────────────────────────────────
// REVIEWS & RATINGS MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  offerId         String?  @map("offer_id")
  merchantId      String?  @map("merchant_id")
  rating          Int      // 1-5 scale
  title           String?
  comment         String   @db.Text
  photos          String[] @default([])
  isVerified      Boolean  @default(false) @map("is_verified") // Verified purchase
  isFeatured      Boolean  @default(false) @map("is_featured") // Staff-pinned
  helpfulCount    Int      @default(0) @map("helpful_count") // Cache of helpful votes
  reportCount     Int      @default(0) @map("report_count") // Cache of reports
  status          String   @default("PUBLISHED") // PUBLISHED | PENDING | HIDDEN | DELETED
  moderationNote  String?  @map("moderation_note")
  moderatedAt     DateTime? @map("moderated_at")
  moderatedBy     String?  @map("moderated_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer        Offer?               @relation(fields: [offerId], references: [id], onDelete: Cascade)
  merchant     Merchant?            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  helpfulVotes ReviewHelpfulVote[]
  reports      ReviewReport[]

  @@unique([userId, offerId])
  @@unique([userId, merchantId])
  @@index([offerId, status])
  @@index([merchantId, status])
  @@index([rating])
  @@index([createdAt])
  @@index([helpfulCount])
  @@map("reviews")
}

model ReviewHelpfulVote {
  id        String   @id @default(cuid())
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
  @@map("review_helpful_votes")
}

model ReviewReport {
  id        String   @id @default(cuid())
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  reason    String // 'SPAM' | 'OFFENSIVE' | 'INACCURATE' | 'OTHER'
  comment   String?
  status    String   @default("PENDING") // PENDING | RESOLVED | DISMISSED
  resolvedBy String? @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId, status])
  @@index([userId])
  @@map("review_reports")
}
